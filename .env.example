# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gaptech_certs
DB_USER=gaptech
DB_PASS=

# Address staff type to reach the app; used in QR codes and e-mail links.
BASE_URL=http://localhost/gaptech-certificates/public
# INTERNAL_URL=

# E-mail for password reset codes. Leave SMTP_HOST empty to switch mail off.
# Sent from info@gaptechsolutions.com. SMTP_HOST is that mailbox's provider,
# e.g. smtp.office365.com for Microsoft 365. SMTP_USERNAME is normally the same
# address as SMTP_FROM, and SMTP_PASSWORD is that mailbox's password (or app password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USERNAME=info@gaptechsolutions.com
SMTP_PASSWORD='aoV)ZQm1[+9#[Oj}'
SMTP_FROM=info@gaptechsolutions.com
SMTP_FROM_NAME='GAPTECH Certificates'
SMTP_HELO=

# PDFs. Empty paths = find Chrome automatically.
CHROME_PATH=
WKHTMLTOPDF_PATH=
RENDER_ZOOM=1.299
# PDF_SECRET=

# Staff e-mail domain and the secret that signs one-time codes.
STAFF_EMAIL_DOMAIN=gaptechsolutions.com
APP_SECRET=
