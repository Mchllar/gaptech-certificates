# Copy this file to .env and fill it in. .env holds passwords and is never committed.
# Quote a value ('like this') if it contains spaces, # or other symbols.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gaptech_certs
DB_USER=gaptech
DB_PASS=

# Address staff type to reach the app; used in QR codes and e-mail links.
BASE_URL=http://localhost/gaptech-certificates/public
# INTERNAL_URL=

# E-mail for password reset links. Leave SMTP_HOST empty to switch mail off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME='GAPTECH Certificates'
SMTP_HELO=

# PDFs. Empty paths = find Chrome automatically.
CHROME_PATH=
WKHTMLTOPDF_PATH=
RENDER_ZOOM=1.299
# PDF_SECRET=

# Staff e-mail domain and the secret that signs one-time codes.
STAFF_EMAIL_DOMAIN=gaptechsolutions.com
APP_SECRET=
